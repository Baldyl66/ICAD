# CodeIgniter 4 gitignore
.env
/vendor/
/build/

# Writable directory
/writable/cache/*
!/writable/cache/index.html
!/writable/cache/.htaccess

/writable/debugbar/*
!/writable/debugbar/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

# PHPUnit cache
.phpunit.cache/
.phpunit.result.cache
